# ============================================================
# Test Environment Configuration (.env.test)
# Used when running Vitest unit & integration tests
# ============================================================

# Mock endpoints for MSW
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws-chat
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

# Test Mock AI
GEMINI_API_KEY=test_mock_gemini_api_key_12345
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.0
AI_VISION_LANGUAGE=vi

# Security
COOKIE_REFRESH_TOKEN_NAME=checked_refresh_token_test

