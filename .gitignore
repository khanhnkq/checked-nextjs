# ============================================================
# Checked Next.js - Git Ignore Configuration
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
dist/

# Environment Variables (Secrets should never be committed)
.env*.local
.env.local

# Keep template and shared envs
!.env.example
!.env.development
!.env.production
!.env.test

# Testing & Coverage
/coverage/
*.lcov
.nyc_output

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary & Cache
.turbo
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts
