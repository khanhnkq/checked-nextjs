# ============================================================
# Production Environment Configuration (.env.production)
# Used when running `next build` and production deployments
# ============================================================

# Production Backend Endpoints
NEXT_PUBLIC_API_BASE_URL=https://heroku-7usd-5a73e86b5b14.herokuapp.com/api/v1
NEXT_PUBLIC_WS_URL=wss://heroku-7usd-5a73e86b5b14.herokuapp.com/ws-chat
NEXT_PUBLIC_APP_URL=https://checked.app

# Tắt log debug ở production
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

# AI Configuration
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
AI_VISION_LANGUAGE=vi

# Security
COOKIE_REFRESH_TOKEN_NAME=checked_refresh_token_prod

