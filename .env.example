# ============================================================
# Checked Web (Next.js 15+) - Environment Configuration Template
# Copy this file to .env.local and adjust values for your environment.
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. API & Backend Services (Public - Exposed to Browser)
# ────────────────────────────────────────────────────────────
# URL REST API Backend (Spring Boot 3.3)
NEXT_PUBLIC_API_BASE_URL=https://heroku-7usd-5a73e86b5b14.herokuapp.com/api/v1

# URL STOMP WebSocket Broker (/ws-chat)
NEXT_PUBLIC_WS_URL=wss://heroku-7usd-5a73e86b5b14.herokuapp.com/ws-chat

# Public Web App Domain (Dùng cho Deep Links & chia sẻ link kết bạn)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chế độ Debug & Logging (true | false)
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true

# ────────────────────────────────────────────────────────────
# 2. Google Gemini Vision AI (Server-Only - Bảo mật trong Route Handlers)
# ────────────────────────────────────────────────────────────
# API Key lấy từ Google AI Studio (Không để lộ ra Client Bundle)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model Gemini sử dụng (Khuyến nghị: gemini-2.0-flash hoặc gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Temperature (0.0 - 1.0, 0.2 cho kết quả OCR và JSON ổn định nhất)
GEMINI_TEMPERATURE=0.2

# Ngôn ngữ trích xuất món ăn & hóa đơn (vi | en)
AI_VISION_LANGUAGE=vi

# ────────────────────────────────────────────────────────────
# 3. Security & Cookies (Server-Only)
# ────────────────────────────────────────────────────────────
# Khóa bí mật mã hóa Cookie phiên (Nếu cần mã hóa thêm)
SESSION_COOKIE_SECRET=replace_with_a_random_32_characters_secret_key

# Tên cookie lưu trữ Refresh Token (HttpOnly)
COOKIE_REFRESH_TOKEN_NAME=checked_refresh_token
