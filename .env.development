# ============================================================
# Development Environment Configuration (.env.development)
# Used when running `next dev`
# ============================================================

# REST API & WebSocket (Mặc định trỏ về Heroku backend đã sẵn sàng DB & S3)
NEXT_PUBLIC_API_BASE_URL=https://heroku-7usd-5a73e86b5b14.herokuapp.com/api/v1
NEXT_PUBLIC_WS_URL=wss://heroku-7usd-5a73e86b5b14.herokuapp.com/ws-chat
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bật log debug chi tiết trong console
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true

# AI Configuration
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
AI_VISION_LANGUAGE=vi

# Security
COOKIE_REFRESH_TOKEN_NAME=checked_refresh_token_dev

